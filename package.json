{
  "name": "travel.skill",
  "version": "0.2.0",
  "description": "Turn your travel materials into a personal, shareable travel website \u2014 an agent skill plus a dependency-free static template.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new": "node scripts/new-trip.mjs",
    "dev": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "gaps": "node scripts/gaps.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-release.mjs",
    "preview": "node scripts/serve.mjs --dist dist",
    "site": "node scripts/build-site.mjs",
    "shot": "node scripts/screenshot.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "template": "node scripts/fork-template.mjs",
    "bundle": "node scripts/package-agents.mjs",
    "bundle:check": "node scripts/check-bundle.mjs"
  }
}
